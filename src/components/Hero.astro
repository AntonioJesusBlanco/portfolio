<style>
  .hero-links {
    display: flex;
    gap: 1.2rem;
    margin-top: 1.5rem;
    justify-content: center;
  }

  .contact-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f8b0ff 0%, #7693ff 100%);
    color: white;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 1.5px 2.5px 4px rgba(143, 171, 217, 0.62);
  }

  .contact-link:hover {
    transform: translateY(-4px);
    box-shadow: 3px 5px 6px rgba(116, 126, 141, 0.5);
  }

  .contact-link img {
    filter: brightness(0) invert(1);
    width: 22px;
    height: 22px;
  }

  :global(.dark-mode-fondo) .contact-link {
    background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
  }
</style>
