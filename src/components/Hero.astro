<section id="inicio" class="hero">
  
  <div class="hero-text">
    <h1>Antonio Jesús Blanco Guillén</h1>
    <p>Desarrollador Full Stack | Tecnico soporte N1 / N2 | Tecnico IT</p>
    <div class="hero-links">
      <a href="mailto:antoniojesusblanco20@gmail.com" class="contact-link" title="Email">
        <img src="https://cdn.jsdelivr.net/npm/simple-icons@v11/icons/gmail.svg" alt="Gmail" width="20" height="20" />
      </a>
      <a href="https://github.com/AntonioJesusBlanco" class="contact-link" title="GitHub">
        <img src="https://cdn.jsdelivr.net/npm/simple-icons@v11/icons/github.svg" alt="GitHub" width="20" height="20" />
      </a>
      <a href="https://www.linkedin.com/in/antonio-jes%C3%BAs-blanco-guillen-27297a185/" class="contact-link" title="LinkedIn">
        <img src="https://cdn.jsdelivr.net/npm/simple-icons@v11/icons/linkedin.svg" alt="LinkedIn" width="20" height="20" />
      </a>
    </div>
  </div> 
</section>

<style>
  .hero-links {
    display: flex;
    gap: 1.6rem;
    justify-content: center;
  }

  .contact-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 75px;
    height: 75px;
    border-radius: 10%;
    background: linear-gradient(135deg, #573bf617 0%, #00aaff21 100%);
    color: white;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 15px rgba(0, 116, 137, 0.317);
  }

  .contact-link:hover {
    transform: translateY(-4px);

   }

  .contact-link img {
    filter: invert(0.9);
    width: 42px;
    height: 42px;
  }

  @media (max-width: 768px) {
    .contact-link {
      width: 55px;
      height: 55px;
    }

    .contact-link img {
      width: 27px;
      height: 27px;
    }
  }
  @media (max-width: 480px) {
    .hero {
      margin-top: 4rem;
    }
    .contact-link {
      width: 45px;
      height: 45px;
      margin-top: 40px;
      margin-bottom: 140px;
    }

    .contact-link img {
      width: 28px;
      height: 28px;
    }
  }
</style>
